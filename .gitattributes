# Store and check out text files with LF on every platform.
* text=auto eol=lf

# Build source and configuration
*.cs text diff=csharp
*.csproj text
*.slnx text
*.props text
*.targets text
*.DotSettings text
*.editorconfig text
*.json text
*.yml text
*.yaml text
*.xml text
*.ps1 text
*.cmd text
*.bat text
*.sh text eol=lf

# Documentation and web assets
*.md text
*.pages text
*.html text
*.htm text
*.css text
*.js text
*.svg text
LICENSE text
docs/_headers text
docs/_redirects text

# Images, fonts, documents, and archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.nupkg binary
*.snupkg binary
